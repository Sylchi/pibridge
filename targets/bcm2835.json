{
    "llvm-target": "armv6k-unknown-none-eabi",
    "cpu": "arm1176jzf-s",
    "features": "+armv6k,+vfp2,+vfp2sp,-thumb-mode,-aes,-bf16,-crc,-crypto,-d32,-dotprod,-dsp,-fp-armv8,-fp-armv8d16,-fp-armv8d16sp,-fp-armv8sp,-fp16,-fp16fml,-fp64,-fpregs,-fullfp16,-hwdiv,-hwdiv-arm,-i8mm,-lob,-mve,-mve.fp,-neon,-pacbti,-ras,-sb,-sha2,-vfp3,-vfp3d16,-vfp3d16sp,-vfp3sp,-vfp4,-vfp4d16,-vfp4d16sp,-vfp4sp",
    "build-tags": ["bcm2835", "baremetal", "linux", "arm"],
    "goos": "linux",
    "goarch": "arm",
    "gc": "conservative",
    "scheduler": "tasks",
    "linker": "ld.lld",
    "rtlib": "compiler-rt",
    "libc": "picolibc",
    "default-stack-size": 8192,
    "cflags": [
        "-Werror",
        "-fshort-enums",
        "-fomit-frame-pointer",
        "-mfloat-abi=soft",
        "-fno-exceptions", "-fno-unwind-tables", "-fno-asynchronous-unwind-tables",
        "-ffunction-sections", "-fdata-sections"
    ],
    "ldflags": [
        "--gc-sections"
    ],
    "linkerscript": "targets/bcm2835.ld",
    "extra-files": [
        "targets/bcm2835.s",
        "src/runtime/asm_arm.S",
        "src/internal/task/task_stack_arm.S"
    ]
}
